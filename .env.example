# ---- Telegram (required) ----------------------------------------------------
# 1. Open Telegram, talk to @BotFather, send /newbot, copy the token.
TELEGRAM_BOT_TOKEN=123456789:AA...
# 2. Optional but recommended: only these chat ids may use the bot.
#    Send /start to your bot, then look at the log (or ask @userinfobot) for your id.
TELEGRAM_ALLOWED_CHAT_IDS=

# ---- Market data ------------------------------------------------------------
# yfinance (free, no key) or twelvedata (free key, true XAU/USD spot)
DATA_PROVIDER=yfinance
# GC=F = COMEX gold futures (most reliable), XAUUSD=X = spot (occasionally gappy)
YF_SYMBOL=GC=F
TWELVEDATA_API_KEY=
TWELVEDATA_SYMBOL=XAU/USD
# Live ticks for the terminal: goldapi (free, no key, every second) | twelvedata | yfinance
QUOTE_PROVIDER=goldapi
QUOTE_INTERVAL_SEC=1
# Real-time tick stream for the terminal (best available wins, pushed to the browser instantly):
#   finnhub     – free key at finnhub.io, OANDA XAU/USD trades, tick-by-tick
#   tradingview – TradingView's public quote stream (OANDA:XAUUSD), no key, tick-by-tick
#   goldapi     – gold-api.com polling, no key, every few seconds (fallback)
TICK_SOURCES=finnhub,tradingview,goldapi
FINNHUB_API_KEY=
FINNHUB_SYMBOL=OANDA:XAU_USD
TV_SYMBOLS=OANDA:XAUUSD,FX_IDC:XAUUSD,TVC:GOLD
# GC=F bars are COMEX futures (~$20-30 above spot). With SPOT_BASIS=true they are rescaled
# onto the live spot price so candles, levels and SL/TP match what you see in MT5.
SPOT_BASIS=true

# ---- AI (optional) ----------------------------------------------------------
# With a key: headlines are classified by Claude and every report gets a written
# briefing. Without it: fast keyword rules are used and there is no briefing.
ANTHROPIC_API_KEY=
CLASSIFIER_MODEL=claude-haiku-5-5
ANALYST_MODEL=claude-sonnet-5-5
# a new briefing at most every N minutes (or when the bias changes) – caps the API bill
BRIEFING_INTERVAL_MIN=60

# ---- News -------------------------------------------------------------------
# Comma-separated RSS/Atom URLs. Leave empty for the built-in list of 46 feeds
# (Google News searches incl. Reuters/Bloomberg/CNBC/FT, WSJ, MarketWatch, CNBC,
# BBC, NYT, Fed & BLS releases, Kitco, FXStreet, ForexLive, Investing.com…).
NEWS_FEEDS=
NEWS_LOOKBACK_HOURS=36
NEWS_HALF_LIFE_HOURS=8
MAX_HEADLINES=8
FEED_WORKERS=16
FEED_TIMEOUT_SEC=8

# ---- Economic calendar ------------------------------------------------------
# Free weekly calendar (ForexFactory JSON). Empty disables it.
CALENDAR_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
CALENDAR_CURRENCIES=USD
# Heads-up alert this many minutes before a high-impact release
EVENT_WARN_MIN=30

# ---- Signal engine ----------------------------------------------------------
TECH_WEIGHT=0.6
NEWS_WEIGHT=0.4
ATR_STOP_MULT=1.5
ATR_TARGET_MULT=2.5

# ---- Trade signals ----------------------------------------------------------
# A BUY/SELL *setup* is posted at this confidence or higher (entry zone + SL/TP1/TP2); it goes LIVE only
# when price pulls back into the zone and the 15-minute chart confirms (EMA reclaim, engulfing, rejection
# wick or break of the pullback high/low). Closes on SL/TP2/bias flip or after SIGNAL_MAX_HOURS.
SIGNAL_MIN_CONF=45
SIGNAL_MAX_HOURS=48
SIGNAL_BREAKEVEN_AFTER_TP1=true
SIGNAL_REQUIRE_TRIGGER=true          # false = enter at market as soon as the setup appears (old behaviour)
SIGNAL_PENDING_MAX_HOURS=12          # a setup that never confirms is dropped after this

# ---- Session filter ---------------------------------------------------------
# No new entries in the NY-close dead zone (21-23 UTC), Friday evening, the weekend, the Sunday open,
# or from 30 min before to 15 min after a high-impact USD release. Asian hours allowed with lower confidence.
SESSION_FILTER=true
ASIA_ENTRIES=true
NEWS_BLACKOUT_BEFORE_MIN=30
NEWS_BLACKOUT_AFTER_MIN=15

# ---- Position sizing (defaults; each Telegram chat can override with /risk) ------------------
ACCOUNT_SIZE=
ACCOUNT_CURRENCY=USD      # CAD, EUR, GBP… – risk is shown in this currency using the live USD rate
RISK_PCT=1                # risk guide per trade
FIXED_LOTS=0              # e.g. 0.05 = always show this size and what it risks on each stop; 0 = size by risk %
# Costs charged to every result (live stats and replay): round-trip spread and stop slippage, $/oz
SPREAD_USD=0.30
SLIPPAGE_USD=0.10
CONTRACT_OZ=100

# ---- Scheduling / alerts ----------------------------------------------------
ANALYSIS_INTERVAL_MIN=15
NEWS_SCAN_INTERVAL_MIN=3
PRICE_MOVE_ALERT_PCT=0.8
SEND_CHARTS=true

# ---- Hosting ----------------------------------------------------------------
# On a free Render/Railway instance, ping our own URL every 10 min so it never sleeps.
# KEEPALIVE_URL defaults to Render's RENDER_EXTERNAL_URL.
KEEPALIVE=false
# KEEPALIVE_URL=https://your-app.onrender.com   (leave unset on Render: RENDER_EXTERNAL_URL is used)
KEEPALIVE_INTERVAL_MIN=10

# Hosts without a persistent disk (Render free tier): keep a copy of the database in a Redis-compatible
# store (free Render Key Value: redis://red-xxxx:6379). Snapshots every BACKUP_INTERVAL_SEC and on shutdown.
# REDIS_URL=redis://red-xxxx:6379
BACKUP_INTERVAL_SEC=120

# Replay the last ~60 days of real bars through the rules after start-up (see /backtest). Technical-only.
BACKTEST_ON_START=false
BACKTEST_MAX_AGE_DAYS=7
# Also replay a few alternative managements (no break-even, other targets…) for comparison (slow: ~10 min each)
BACKTEST_SWEEP=false

# ---- Misc -------------------------------------------------------------------
DB_PATH=data/sentinel.db
LOG_LEVEL=INFO
