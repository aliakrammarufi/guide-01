# ---- Telegram (required) ----------------------------------------------------
# 1. Open Telegram, talk to @BotFather, send /newbot, copy the token.
TELEGRAM_BOT_TOKEN=123456789:AA...
# 2. Optional but recommended: only these chat ids may use the bot.
#    Send /start to your bot, then look at the log (or ask @userinfobot) for your id.
TELEGRAM_ALLOWED_CHAT_IDS=

# ---- Market data ------------------------------------------------------------
# yfinance (free, no key) or twelvedata (free key, true XAU/USD spot)
DATA_PROVIDER=yfinance
# GC=F = COMEX gold futures (most reliable), XAUUSD=X = spot (occasionally gappy)
YF_SYMBOL=GC=F
TWELVEDATA_API_KEY=
TWELVEDATA_SYMBOL=XAU/USD
# Live ticks for the terminal: goldapi (free, no key, every second) | twelvedata | yfinance
QUOTE_PROVIDER=goldapi
QUOTE_INTERVAL_SEC=1

# ---- AI (optional) ----------------------------------------------------------
# With a key: headlines are classified by Claude and every report gets a written
# briefing. Without it: fast keyword rules are used and there is no briefing.
ANTHROPIC_API_KEY=
CLASSIFIER_MODEL=claude-haiku-5-5
ANALYST_MODEL=claude-sonnet-5-5

# ---- News -------------------------------------------------------------------
# Comma-separated RSS/Atom URLs. Leave empty for the built-in list of 46 feeds
# (Google News searches incl. Reuters/Bloomberg/CNBC/FT, WSJ, MarketWatch, CNBC,
# BBC, NYT, Fed & BLS releases, Kitco, FXStreet, ForexLive, Investing.com…).
NEWS_FEEDS=
NEWS_LOOKBACK_HOURS=36
NEWS_HALF_LIFE_HOURS=8
MAX_HEADLINES=8
FEED_WORKERS=16
FEED_TIMEOUT_SEC=8

# ---- Economic calendar ------------------------------------------------------
# Free weekly calendar (ForexFactory JSON). Empty disables it.
CALENDAR_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
CALENDAR_CURRENCIES=USD
# Heads-up alert this many minutes before a high-impact release
EVENT_WARN_MIN=30

# ---- Signal engine ----------------------------------------------------------
TECH_WEIGHT=0.6
NEWS_WEIGHT=0.4
ATR_STOP_MULT=1.5
ATR_TARGET_MULT=2.5

# ---- Trade signals ----------------------------------------------------------
# A BUY/SELL call opens at this confidence or higher; closes on SL/TP2/bias flip or after SIGNAL_MAX_HOURS
SIGNAL_MIN_CONF=45
SIGNAL_MAX_HOURS=48
SIGNAL_BREAKEVEN_AFTER_TP1=true

# ---- Scheduling / alerts ----------------------------------------------------
ANALYSIS_INTERVAL_MIN=15
NEWS_SCAN_INTERVAL_MIN=3
PRICE_MOVE_ALERT_PCT=0.8
SEND_CHARTS=true

# ---- Misc -------------------------------------------------------------------
DB_PATH=data/sentinel.db
LOG_LEVEL=INFO
